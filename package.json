  "license": "MIT",
  "homepage": "https://github.com/adityarachuri/swarakala-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityarachuri/swarakala-studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:compliance": "node scripts/verify-repo-compliance.mjs",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
